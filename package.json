{
  "name": "elastic-tool",
  "version": "0.1.0",
  "description": "Elasticsearch desktop client built with Electron, React and shadcn/ui",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": "elastic-tool contributors",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder",
    "ui:add": "node scripts/add-ui.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.78.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "com.elastictool.desktop",
    "productName": "elastic-tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!src/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!.tmp/**/*",
      "!**/*.md",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!electron.vite.config.ts",
      "!vitest.config.ts",
      "!tsconfig.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
